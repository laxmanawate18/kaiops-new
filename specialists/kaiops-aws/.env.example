# Local development configuration
# For deployment, these are set via Terraform / the deploy command.
# kaiops-aws = self-contained AWS RCA Specialist reasoning engine.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=project-3da8cb5f-328e-44d3-b7a
GOOGLE_CLOUD_LOCATION=us-central1

# Model
GEMINI_MODEL=gemini-3.6-flash

# AWS RCA (CloudWatch / EKS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
AWS_ACCOUNT_ID=
AWS_CLUSTER_NAME=log-agent-eks
AWS_CLUSTER_TYPE=eks
AWS_CLOUDWATCH_LOG_GROUP=/aws/containerinsights/log-agent-eks/application

# A2A bearer token shared with the orchestrator (injected from Secret Manager
# at deploy; stored as the A2A_SHARED_TOKEN secret). Keep empty locally.
A2A_SHARED_TOKEN=
A2A_SHARED_TOKEN_SECRET=

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here
