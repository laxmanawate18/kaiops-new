# KaiOps — Governed Multi-Cloud SRE Agent Fleet (Mermaid restyle source)
# Model: Gemini Enterprise Agent Platform · gemini-3.6-flash (Vertex AI)

flowchart LR
    subgraph VERTEX["Vertex AI — Gemini Enterprise Agent Platform"]
        G["gemini-3.6-flash<br/>(Vertex AI)"]
    end

    subgraph ORCH["KaiOps Orchestrator"]
        E["Agent Engine"]
        R["Agent Registry"]
        I["Agent Identity"]
        GW["Agent Gateway"]
        SG["Semantic Governance"]
    end

    subgraph SPEC["3 A2A Specialists (Cloud Run)"]
        GCP["gcp"]
        AWS["aws"]
        AZ["azure"]
    end

    subgraph MCP["6 MCP Servers (Cloud Run, IAM-private)"]
        M1["argocd"]
        M2["aws"]
        M3["azure"]
        M4["gcp"]
        M5["github"]
        M6["grafana"]
    end

    subgraph ESTATE["Managed Estate"]
        K8S["GKE"]
        EKS["EKS"]
        AKS["AKS"]
    end

    G --> ORCH
    ORCH --> SPEC
    SPEC --> MCP
    MCP --> ESTATE

    subgraph DATA["State / Jobs"]
        FS["Firestore<br/>state · jobs · sessions"]
    end

    subgraph LOOP["Autonomous Loop"]
        direction TB
        WH["Webhook<br/>(ArgoCD Degraded / K8s crash)"] --> JOB["agent_jobs PENDING"]
        JOB --> W["/worker/run (claims, CAS)"]
        W --> RCA["RCA (search_knowledge)"]
        RCA --> SLACK["Slack report + deep-link"]
        SLACK --> HITL["HITL Approve/Reject"]
        HITL --> REM["cloud-aware remediation (GKE/EKS/AKS)"]
    end

    FS --> JOB
    LOOP --> ORCH

    classDef prim fill:#eef2ff,stroke:#6366f1,stroke-width:2;
    classDef spec fill:#f0fdf4,stroke:#16a34a,stroke-width:1.5;
    classDef mcp fill:#fef2f2,stroke:#dc2626,stroke-width:1.5;
    classDef est fill:#fefce8,stroke:#ca8a04,stroke-width:1.5;
    classDef vert fill:#e0f2fe,stroke:#0284c7,stroke-width:1.5;
    classDef loop fill:#f1f5f9,stroke:#94a3b8;

    class G vert;
    class E,R,I,GW,SG prim;
    class GCP,AWS,AZ spec;
    class M1,M2,M3,M4,M5,M6 mcp;
    class K8S,EKS,AKS est;

style MODEL_ARMOR fill:#ffffff,stroke:#0f766e
# Model Armor: template kaiops-governance-template (separate from the gateway,
# which exposes no model-armor binding field; enforcement is app-layer + HITL).
