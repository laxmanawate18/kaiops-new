# Local development configuration
# For deployment, these are set via Terraform / the deploy command.
# kaiops-azure = self-contained Azure RCA Specialist reasoning engine.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=project-3da8cb5f-328e-44d3-b7a
GOOGLE_CLOUD_LOCATION=us-central1

# Model
GEMINI_MODEL=gemini-3.6-flash

# Azure RCA (real Log Analytics via service principal; mock fallback gated)
AZURE_MCP_ENABLED=false
AZURE_MOCK_MODE=false
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_LOG_ANALYTICS_WORKSPACE_ID=
AZURE_SUBSCRIPTION_ID=

# A2A bearer token shared with the orchestrator (injected from Secret Manager
# at deploy; stored as the A2A_SHARED_TOKEN secret). Keep empty locally.
A2A_SHARED_TOKEN=
A2A_SHARED_TOKEN_SECRET=

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here
