# Multi-stage build for frontend
FROM node:18-alpine as builder

WORKDIR /app
ARG VITE_API_URL=https://sre-agent-backend-275388304596.us-central1.run.app/api/v1
ENV VITE_API_URL=$VITE_API_URL

COPY apps/web/package*.json ./
RUN npm ci

COPY apps/web/ .
RUN VITE_API_URL=$VITE_API_URL npm run build

FROM nginx:alpine

RUN rm -f /etc/nginx/conf.d/default.conf &&     printf "server {\n    listen 80;\n    server_name _;\n    root /usr/share/nginx/html;\n    index index.html;\n    location / {\n        try_files \$uri \$uri/ /index.html;\n    }\n}\n# CACHE BUST v5\n" > /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist /usr/share/nginx/html
COPY infrastructure/k8s/update-api-url.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3     CMD wget --quiet --tries=1 --spider http://localhost:80/index.html || exit 1 

EXPOSE 80

ENTRYPOINT ["/entrypoint.sh"]
