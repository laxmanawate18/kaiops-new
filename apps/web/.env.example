# Base URL for the KaiOPS API. Leave as-is to use the dev proxy / same-origin nginx.
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server proxies API calls (dev only — not part of the bundle).
VITE_PROXY_TARGET=http://localhost:8000

# ADK app name used for agent session routing.
VITE_ADK_APP_NAME=kaiops

# Optional deep-link bases for the service registry. Omitted => the button is hidden.
VITE_GRAFANA_URL=
VITE_ARGOCD_URL=
VITE_GITHUB_URL=https://github.com

# Shown in the UI chrome. Purely cosmetic.
VITE_ENVIRONMENT=development
